# Gemini API Configuration (leave empty to use offline heuristic fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# SQLite Database path
DATABASE_PATH=./invoice_processing.db

# File upload storage directory
UPLOAD_DIR=./uploads

# Demo mode: bypass external auth, pre-populate sessions
DEMO_MODE=true
